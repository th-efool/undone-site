// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  username      String?        @unique
  bio           String?
  role          UserRole       @default(EXPLORER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  sessions      Session[]
  publicProfile PublicProfile?

  cohorts           Cohort[]
  cohortMemberships CohortMember[]
  messages          Message[]
  studyRooms        RoomParticipant[]
  lessonProgress    LessonProgress[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PublicProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  slug      String   @unique
  headline  String?
  links     Json     @default("[]")
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("public_profiles")
}

enum UserRole {
  EXPLORER
  CREATOR
  ADMIN
}

// ─────────────────────────────────────────────────────────────────
//  COHORT — The core learning journey (contains Seasons and Lessons)
// ─────────────────────────────────────────────────────────────────
model Cohort {
  id           String     @id @default(cuid())
  creatorId    String
  title        String
  subtitle     String?
  description  String?    @db.Text
  coverImage   String?
  difficulty   Difficulty @default(BEGINNER)
  visibility   Visibility @default(PUBLIC)
  qualityScore Int        @default(0)
  isPublished  Boolean    @default(false)
  publishedAt  DateTime?

  categories              String[]
  estimatedCompletionTime String?
  language                String?
  primaryTopic            String?
  tags                    String[]
  requirements            String[]
  learningOutcomes        String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator   User           @relation(fields: [creatorId], references: [id])
  members   CohortMember[]
  seasons   Season[]
  community Community?
  sources   CohortSource[]

  @@map("cohorts")
}

// ─────────────────────────────────────────────────────────────────
//  COHORT SOURCE — The resources used to build a cohort
// ─────────────────────────────────────────────────────────────────
model CohortSource {
  id             String     @id @default(cuid())
  cohortId       String
  type           SourceType
  title          String
  url            String
  thumbnailUrl   String?
  domain         String?
  metaTitle      String?
  chunkingMethod String?

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@map("cohort_sources")
}

// ─────────────────────────────────────────────────────────────────
//  SEASON — A grouping of lessons within a Cohort (the Questline)
// ─────────────────────────────────────────────────────────────────
model Season {
  id        String   @id @default(cuid())
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cohortId String
  cohort   Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@map("seasons")
}

// ─────────────────────────────────────────────────────────────────
//  LESSON — A single video/article/task within a Season
// ─────────────────────────────────────────────────────────────────
model Lesson {
  id           String     @id @default(cuid())
  seasonId     String
  title        String
  description  String?    @db.Text
  videoUrl     String?
  videoId      String?
  thumbnailUrl String?
  duration     Int? // Duration in seconds
  order        Int // Position in season
  lessonType   LessonType @default(VIDEO)
  isPublished  Boolean    @default(false)
  chunks       Json? // Stores CurriculumChunk array
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  season   Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@map("lessons")
}

// ─────────────────────────────────────────────────────────────────
//  COMMUNITY — 1:1 Social Hub for a Cohort
// ─────────────────────────────────────────────────────────────────
model Community {
  id            String  @id @default(cuid())
  chatEnabled   Boolean @default(true)
  eventsEnabled Boolean @default(true)

  cohortId String    @unique
  cohort   Cohort    @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  channels Channel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("communities")
}

model Channel {
  id          String    @id @default(cuid())
  name        String
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  messages    Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("channels")
}

model Message {
  id        String  @id @default(cuid())
  content   String  @db.Text
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("messages")
}

// ─────────────────────────────────────────────────────────────────
//  STUDY ROOM — Global Standalone Voice Spaces
// ─────────────────────────────────────────────────────────────────
model StudyRoom {
  id          String @id @default(cuid())
  title       String
  thumbnail   String
  status      String
  onlineCount Int    @default(0)

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  participants RoomParticipant[]

  @@map("study_rooms")
}

model RoomParticipant {
  id          String @id @default(cuid())
  userId      String @unique
  studyRoomId String

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  room     StudyRoom @relation(fields: [studyRoomId], references: [id], onDelete: Cascade)
  joinedAt DateTime  @default(now())

  @@index([studyRoomId])
  @@map("room_participants")
}

// ─────────────────────────────────────────────────────────────────
//  COHORT MEMBER — Who has joined a cohort
// ─────────────────────────────────────────────────────────────────
model CohortMember {
  cohortId String
  userId   String
  role     MemberRole @default(EXPLORER)
  joinedAt DateTime   @default(now())

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cohortId, userId])
  @@map("cohort_members")
}

// ─────────────────────────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────────────────────────
enum SourceType {
  YOUTUBE_PLAYLIST
  YOUTUBE_VIDEO
  WEBSITE
  PDF
  MARKDOWN
  GITHUB_REPO
  NOTION
  CUSTOM_LINK
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Visibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum LessonType {
  VIDEO
  ARTICLE
  QUIZ
  ASSIGNMENT
  LIVE
}

enum MemberRole {
  EXPLORER
  MODERATOR
  CREATOR
}

enum LessonStatus {
  IN_PROGRESS
  COMPLETED
}

model LessonProgress {
  userId    String
  lessonId  String
  status    LessonStatus @default(IN_PROGRESS)
  updatedAt DateTime     @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@map("lesson_progress")
}
