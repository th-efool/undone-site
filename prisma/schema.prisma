// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  username      String?        @unique
  bio           String?
  role          UserRole       @default(EXPLORER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  sessions      Session[]
  publicProfile PublicProfile?

  cohorts           Cohort[]
  cohortMemberships CohortMember[]
  messages          Message[]
  studyRooms        RoomParticipant[]
  lessonProgress    LessonProgress[]
  creationDrafts    CreationDraft[]
  interactionWorkspaces InteractionWorkspace[]
  invitedCohorts    CohortInvitation[] @relation("InvitedCohorts")
  acceptedInvitations CohortInvitation[] @relation("AcceptedInvitations")
  restriction       UserRestriction?
  createdConversations Conversation[] @relation("CreatedConversations")
  conversationMemberships ConversationParticipant[]
  channelStates     ChannelUserState[]
  realtimeStream    RealtimeStream?
  messagingRequests MessagingRequest[]
  blockedUsers      UserBlock[] @relation("UserBlocker")
  blockedByUsers    UserBlock[] @relation("UserBlocked")
  messageReports    MessageReport[]
  sentConversationInvites ConversationInvitation[] @relation("ConversationInvitedBy")
  receivedConversationInvites ConversationInvitation[] @relation("ConversationInvitedTo")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PublicProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  slug      String   @unique
  headline  String?
  links     Json     @default("[]")
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("public_profiles")
}

enum UserRole {
  EXPLORER
  CREATOR
  ADMIN
}

model CreationDraft {
  id            String   @id @default(uuid())
  ownerId       String
  revision      Int      @default(0)
  schemaVersion Int      @default(1)
  snapshot      Json
  eventSequence Int      @default(0)
  expiredAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  jobs          CreationJob[]
  events        CreationEvent[]
  storageObjects CreationStorageObject[]

  @@index([ownerId, updatedAt])
  @@map("creation_drafts")
}

model CreationJob {
  id String @id @default(uuid())
  draftId String
  ownerId String
  kind String
  requestId String
  inputRevision Int
  inputFingerprint String
  input Json
  status String @default("queued")
  attempt Int @default(0)
  checkpoint Json?
  nextRunAt DateTime @default(now())
  leaseOwner String?
  leaseToken String?
  leaseUntil DateTime?
  heartbeatAt DateTime?
  deadlineAt DateTime?
  cancelRequestedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  draft CreationDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  @@unique([draftId, kind, inputFingerprint])
  @@index([status, nextRunAt, leaseUntil])
  @@map("creation_jobs")
}

model CreationEvent {
  id String @id @default(uuid())
  draftId String
  sequence Int
  envelope Json
  createdAt DateTime @default(now())
  draft CreationDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  @@unique([draftId, sequence])
  @@index([createdAt])
  @@map("creation_events")
}

model CreationBudget {
  key String @id
  used Int @default(0)
  expiresAt DateTime
  @@map("creation_budgets")
}

model CreationStorageObject {
  id String @id @default(uuid())
  draftId String
  ownerId String
  blobId String @unique
  kind String
  status String @default("uploading")
  mediaType String
  filename String?
  byteLength Int @default(0)
  reservedBytes Int
  checksum String?
  artifactType String?
  schemaVersion Int?
  inputFingerprint String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  referencedAt DateTime?
  readLeaseUntil DateTime?
  publishedAt DateTime?
  deletingToken String?
  draft CreationDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)
  @@index([draftId, status])
  @@index([status, createdAt])
  @@map("creation_storage_objects")
}

model InteractionWorkspace {
  id             String   @id @default(uuid())
  ownerId        String
  domainId       String
  domainVersion  Int
  snapshot       Json
  revision       Int      @default(0)
  contextEpoch   Int      @default(0)
  sequence       Int      @default(0)
  lifecycle      String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requests       InteractionRequest[]
  events         InteractionEvent[]
  outbox         InteractionOutbox[]
  messages       InteractionMessage[]
  runs           InteractionRun[]
  proposals      InteractionProposal[]
  cohortTextArtifacts CohortTextArtifact[]
  cohortTextJobs      CohortTextJob[]

  @@index([ownerId, updatedAt])
  @@index([domainId, lifecycle])
  @@map("interaction_workspaces")
}

model InteractionRequest {
  id           String   @id @default(uuid())
  workspaceId  String
  actorId      String
  operation    String
  requestId    String
  payloadHash  String
  response     Json
  createdAt    DateTime @default(now())
  workspace    InteractionWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, actorId, operation, requestId])
  @@index([createdAt])
  @@map("interaction_requests")
}

model InteractionEvent {
  id              String   @id @default(uuid())
  workspaceId     String
  sequence        Int
  protocolVersion Int      @default(1)
  type            String
  revision        Int?
  payload         Json
  createdAt       DateTime @default(now())
  workspace       InteractionWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sequence])
  @@index([createdAt])
  @@map("interaction_events")
}

model InteractionMessage {
  id           String   @id @default(uuid())
  workspaceId  String
  role         String
  parts        Json
  sequence     Int
  runId        String?
  createdAt    DateTime @default(now())
  workspace    InteractionWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sequence])
  @@map("interaction_messages")
}

model InteractionOutbox {
  id           String   @id @default(uuid())
  workspaceId  String
  kind         String
  payload      Json
  dedupKey     String   @unique
  status       String   @default("pending")
  attempts     Int      @default(0)
  dueAt        DateTime @default(now())
  leaseOwner   String?
  leaseToken   String?
  leaseUntil   DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  workspace    InteractionWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, dueAt, leaseUntil])
  @@map("interaction_outbox")
}

model InteractionRun {
  id                  String   @id @default(uuid())
  workspaceId         String
  triggeringMessageId String?
  status              String   @default("queued")
  contextEpoch        Int      @default(0)
  observedRevision    Int      @default(0)
  cursor              Int      @default(0)
  fence               Int      @default(0)
  leaseOwner          String?
  leaseToken          String?
  leaseUntil          DateTime?
  deadline            DateTime?
  budgetReservation   Json?
  budgetActual        Json?
  error               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  workspace           InteractionWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps               InteractionStep[]

  @@index([workspaceId, status])
  @@index([status, leaseUntil])
  @@map("interaction_runs")
}

model InteractionStep {
  id           String   @id @default(uuid())
  runId        String
  ordinal      Int
  kind         String
  toolName     String?
  inputHash    String?
  inputPayload Json?
  state        String   @default("started")
  result       Json?
  error        String?
  effectKey    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  run          InteractionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, ordinal])
  @@index([runId, toolName, inputHash])
  @@map("interaction_steps")
}

model InteractionProposal {
  id            String   @id @default(uuid())
  workspaceId   String
  actionPayload Json
  readSet       Json?
  summary       String
  state         String   @default("pending")
  expiresAt     DateTime?
  decisionActor String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  workspace     InteractionWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, state])
  @@map("interaction_proposals")
}

// Host-owned S3 storage. The running text worker continues using the
// interaction snapshot until this additive schema is applied and verified.
model CohortTextArtifact {
  id               String   @id @default(uuid())
  workspaceId      String
  sourceId         String?
  sourceVersion    Int?
  kind             String
  inputFingerprint String
  checksum         String
  byteLength       Int
  body             Bytes    @db.ByteA
  createdAt        DateTime @default(now())
  workspace        InteractionWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resultForJob     CohortTextJob?

  @@unique([id, workspaceId])
  @@index([workspaceId, sourceId, sourceVersion, kind])
  @@map("cohort_text_artifacts")
}

model CohortTextJob {
  id                    String   @id @default(uuid())
  workspaceId           String
  jobKey                String
  sourceId              String?
  sourceVersion         Int?
  stage                 String
  handlerVersion        Int      @default(1)
  dependencyFingerprint String
  status                String   @default("queued")
  attempts              Int      @default(0)
  dueAt                 DateTime @default(now())
  fence                 Int      @default(0)
  leaseOwner            String?
  leaseToken            String?
  leaseUntil            DateTime?
  resultArtifactId      String?
  errorCode             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  workspace             InteractionWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resultArtifact        CohortTextArtifact? @relation(fields: [resultArtifactId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  prerequisites         CohortTextJobEdge[] @relation("JobPrerequisites")
  dependents            CohortTextJobEdge[] @relation("JobDependents")

  @@unique([workspaceId, jobKey])
  @@unique([id, workspaceId])
  @@unique([resultArtifactId, workspaceId])
  @@index([status, dueAt, leaseUntil])
  @@index([workspaceId, sourceId, sourceVersion])
  @@map("cohort_text_jobs")
}

model CohortTextJobEdge {
  workspaceId    String
  jobId          String
  prerequisiteId String
  job            CohortTextJob @relation("JobPrerequisites", fields: [jobId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  prerequisite   CohortTextJob @relation("JobDependents", fields: [prerequisiteId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@id([workspaceId, jobId, prerequisiteId])
  @@map("cohort_text_job_edges")
}

// ─────────────────────────────────────────────────────────────────
//  COHORT — The core learning journey (contains Seasons and Lessons)
// ─────────────────────────────────────────────────────────────────
model Cohort {
  id           String     @id @default(cuid())
  creatorId    String
  title        String
  subtitle     String?
  description  String?    @db.Text
  coverImage   String?
  difficulty   Difficulty @default(BEGINNER)
  visibility   Visibility @default(PUBLIC)
  qualityScore Int        @default(0)
  isPublished  Boolean    @default(false)
  publishedAt  DateTime?
  creationSettings Json?

  categories              String[]
  estimatedCompletionTime String?
  language                String?
  primaryTopic            String?
  tags                    String[]
  requirements            String[]
  learningOutcomes        String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator   User           @relation(fields: [creatorId], references: [id])
  members   CohortMember[]
  seasons   Season[]
  community Community?
  sources   CohortSource[]
  invitations CohortInvitation[]

  @@index([creatorId])
  @@index([isPublished, visibility, publishedAt])
  @@index([isPublished, visibility, qualityScore])
  @@map("cohorts")
}

// ─────────────────────────────────────────────────────────────────
//  COHORT SOURCE — The resources used to build a cohort
// ─────────────────────────────────────────────────────────────────
model CohortSource {
  id             String     @id @default(cuid())
  cohortId       String
  type           SourceType
  title          String
  url            String
  thumbnailUrl   String?
  domain         String?
  metaTitle      String?
  chunkingMethod String?

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId])
  @@map("cohort_sources")
}

// ─────────────────────────────────────────────────────────────────
//  SEASON — A grouping of lessons within a Cohort (the Questline)
// ─────────────────────────────────────────────────────────────────
model Season {
  id        String   @id @default(cuid())
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cohortId String
  cohort   Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([cohortId])
  @@map("seasons")
}

// ─────────────────────────────────────────────────────────────────
//  LESSON — A single video/article/task within a Season
// ─────────────────────────────────────────────────────────────────
model Lesson {
  id           String     @id @default(cuid())
  seasonId     String
  title        String
  description  String?    @db.Text
  videoUrl     String?
  videoId      String?
  sourceUrl    String?
  thumbnailUrl String?
  duration     Int? // Duration in seconds
  order        Int // Position in season
  lessonType   LessonType @default(VIDEO)
  isPublished  Boolean    @default(false)
  chunks       Json? // Stores CurriculumChunk array
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  season   Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([seasonId])
  @@index([seasonId, order])
  @@index([isPublished, seasonId])
  @@map("lessons")
}

// ─────────────────────────────────────────────────────────────────
//  COMMUNITY — 1:1 Social Hub for a Cohort
// ─────────────────────────────────────────────────────────────────
model Community {
  id            String  @id @default(cuid())
  chatEnabled   Boolean @default(true)
  eventsEnabled Boolean @default(true)
  accessGeneration Int   @default(1)

  cohortId String    @unique
  cohort   Cohort    @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  channels Channel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("communities")
}

enum ConversationKind {
  DIRECT
  GROUP
}

model Conversation {
  id               String                    @id @default(cuid())
  kind             ConversationKind          @default(DIRECT)
  title            String?
  creatorId        String
  directKey        String?                   @unique
  accessGeneration Int                       @default(1)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  creator          User                      @relation("CreatedConversations", fields: [creatorId], references: [id], onDelete: Restrict)
  participants     ConversationParticipant[]
  invitations      ConversationInvitation[]
  channel          Channel?

  @@index([creatorId])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId             String
  userId                     String
  role                       String                   @default("MEMBER")
  joinedAt                   DateTime                 @default(now())
  leftAt                     DateTime?
  historyVisibleFromSequence Int                      @default(0)

  conversation               Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user                       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, leftAt, conversationId])
  @@map("conversation_participants")
}

model Channel {
  id             String             @id @default(cuid())
  name           String
  communityId    String?
  community      Community?         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  conversationId String?            @unique
  conversation   Conversation?      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  studyRoomId    String?            @unique
  studyRoom      StudyRoom?         @relation(fields: [studyRoomId], references: [id], onDelete: Cascade)
  slug           String?
  messageCounter Int                @default(0)

  messages       Message[]
  userStates     ChannelUserState[]
  realtimeStream RealtimeStream?

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([communityId])
  @@index([conversationId])
  @@index([studyRoomId])
  @@map("channels")
}

model Message {
  id              String             @id @default(cuid())
  content         String             @db.Text
  channelId       String
  channel         Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)

  authorId        String
  author          User               @relation(fields: [authorId], references: [id], onDelete: Cascade)

  messageSequence Int                @default(0)
  clientRequestId String?
  payloadHash     String?
  replyToId       String?
  replyTo         Message?           @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[]          @relation("MessageReplies")
  reports         MessageReport[]
  revision        Int                @default(1)
  editedAt        DateTime?
  deletedAt       DateTime?
  deletionReason  String?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([channelId, messageSequence])
  @@unique([channelId, authorId, clientRequestId])
  @@index([channelId])
  @@index([authorId])
  @@index([replyToId])
  @@index([channelId, createdAt(sort: Desc)])
  @@map("messages")
}

model ChannelUserState {
  channelId             String
  userId                String
  lastReadSequence      Int       @default(0)
  lastDeliveredSequence Int       @default(0)
  isPinned              Boolean   @default(false)
  mutedUntil            DateTime?
  updatedAt             DateTime  @updatedAt

  channel               Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
  @@map("channel_user_states")
}

model RealtimeStream {
  id           String             @id @default(cuid())
  channelId    String?            @unique
  studyRoomId  String?            @unique
  userId       String?            @unique
  generation   Int                @default(1)
  eventCounter Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  channel      Channel?           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  studyRoom    StudyRoom?         @relation(fields: [studyRoomId], references: [id], onDelete: Cascade)
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  events       RealtimeEvent[]

  @@map("realtime_streams")
}

model RealtimeEvent {
  id              String             @id @default(cuid())
  streamId        String
  sequence        Int
  eventId         String             @unique
  schemaVersion   Int                @default(1)
  type            String
  generation      Int                @default(1)
  entityId        String?
  entityRevision  Int?
  clientRequestId String?
  payload         Json
  occurredAt      DateTime           @default(now())

  stream          RealtimeStream     @relation(fields: [streamId], references: [id], onDelete: Cascade)
  deliveries      RealtimeDelivery[]

  @@unique([streamId, sequence])
  @@index([streamId, occurredAt])
  @@index([occurredAt])
  @@map("realtime_events")
}

enum RealtimeDeliveryStatus {
  PENDING
  DELIVERED
  DEAD_LETTER
}

model RealtimeDelivery {
  id          String                 @id @default(cuid())
  eventId     String
  destination String
  status      RealtimeDeliveryStatus @default(PENDING)
  attempts    Int                    @default(0)
  dueAt       DateTime               @default(now())
  leaseOwner  String?
  leaseToken  String?
  leaseUntil  DateTime?
  deliveredAt DateTime?
  lastError   String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  event       RealtimeEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, destination])
  @@index([status, dueAt, leaseUntil])
  @@map("realtime_deliveries")
}

model MessagingRequest {
  id          String   @id @default(cuid())
  actorId     String
  operation   String
  scope       String
  requestId   String
  payloadHash String
  response    Json
  createdAt   DateTime @default(now())

  actor       User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([actorId, operation, scope, requestId])
  @@index([createdAt])
  @@map("messaging_requests")
}

// ─────────────────────────────────────────────────────────────────
//  STUDY ROOM — Global Standalone Voice Spaces
// ─────────────────────────────────────────────────────────────────
model StudyRoom {
  id          String @id @default(cuid())
  title       String
  thumbnail   String
  status      String
  onlineCount Int    @default(0)

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  participants RoomParticipant[]
  channel      Channel?
  realtimeStream RealtimeStream?

  @@map("study_rooms")
}

model RoomParticipant {
  id          String @id @default(cuid())
  userId      String @unique
  studyRoomId String

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  room     StudyRoom @relation(fields: [studyRoomId], references: [id], onDelete: Cascade)
  joinedAt DateTime  @default(now())

  @@index([studyRoomId])
  @@index([userId])
  @@index([userId, studyRoomId])
  @@map("room_participants")
}

// ─────────────────────────────────────────────────────────────────
//  COHORT MEMBER — Who has joined a cohort
// ─────────────────────────────────────────────────────────────────
model CohortMember {
  cohortId String
  userId   String
  role     MemberRole @default(EXPLORER)
  joinedAt DateTime   @default(now())

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cohortId, userId])
  @@index([userId])
  @@map("cohort_members")
}

// ─────────────────────────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────────────────────────
enum SourceType {
  YOUTUBE_PLAYLIST
  YOUTUBE_VIDEO
  WEBSITE
  PDF
  MARKDOWN
  GITHUB_REPO
  NOTION
  CUSTOM_LINK
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Visibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum LessonType {
  VIDEO
  ARTICLE
  QUIZ
  ASSIGNMENT
  LIVE
}

enum MemberRole {
  EXPLORER
  MODERATOR
  CREATOR
}

enum LessonStatus {
  IN_PROGRESS
  COMPLETED
}

model LessonProgress {
  userId    String
  lessonId  String
  status    LessonStatus @default(IN_PROGRESS)
  updatedAt DateTime     @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model CohortInvitation {
  id           String    @id @default(cuid())
  cohortId     String
  inviterId    String
  email        String?
  tokenHash    String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  cohort     Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  inviter    User   @relation("InvitedCohorts", fields: [inviterId], references: [id], onDelete: Cascade)
  acceptedBy User?  @relation("AcceptedInvitations", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([cohortId])
  @@index([tokenHash])
  @@index([email])
  @@map("cohort_invitations")
}

model UserRestriction {
  id        String    @id @default(cuid())
  userId    String    @unique
  reason    String?
  bannedAt  DateTime  @default(now())
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_restrictions")
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model MessageReport {
  id         String   @id @default(cuid())
  reporterId String
  messageId  String
  reason     String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([reporterId])
  @@map("message_reports")
}

model ConversationInvitation {
  id             String    @id @default(cuid())
  conversationId String
  inviterId      String
  inviteeId      String
  status         String    @default("PENDING")
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  inviter        User         @relation("ConversationInvitedBy", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee        User         @relation("ConversationInvitedTo", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([conversationId, inviteeId, status])
  @@index([inviteeId, status])
  @@map("conversation_invitations")
}
