# Application
APP_URL=http://localhost:3000
PORT=3000

# NextAuth / Auth.js
# Secret must be at least 32 characters in production
AUTH_SECRET=your_auth_secret_here_at_least_32_chars
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# OAuth Providers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SLACK_ID=
AUTH_SLACK_SECRET=

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/undone?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/undone?schema=public

# MongoDB (Learner Preferences & AI Progress)
MONGODB_URI=mongodb://localhost:27017/undone
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Centrifugo Real-time Transport (v6.10.0)
# Independent cryptographically random secret (minimum 32 bytes/characters) for connection JWTs
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=replace_with_random_32_character_secret_for_jwt
# Server API key for backend publisher and worker
CENTRIFUGO_API_KEY=replace_with_random_server_api_key
# Static key for authenticating Centrifugo proxy callbacks in Next.js
CENTRIFUGO_PROXY_STATIC_KEY=replace_with_random_proxy_callback_static_key
# Internal API URL for backend and worker
CENTRIFUGO_API_URL=http://localhost:8000/api
# Public WebSocket endpoint served to browser/Capacitor clients
NEXT_PUBLIC_CENTRIFUGO_WS_URL=ws://localhost:8000/connection/websocket
# Token claims
CENTRIFUGO_ISSUER=undone-messaging
CENTRIFUGO_AUDIENCE=undone-centrifugo
# URL accessible from inside Docker to reach Next.js callback endpoints
CENTRIFUGO_PROXY_URL=http://host.docker.internal:3000

# Optional Third-Party Services
GEMINI_API_KEY=
YOUTUBE_API_KEY=
