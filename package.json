{
  "name": "undone",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preinstall": "node scripts/ensure-submodules.mjs",
    "dev:bare": "node --import ./scripts/register-root-environment.mjs ./node_modules/next/dist/bin/next dev",
    "build:notes": "node -e \"if (!require('fs').existsSync('packages/notes-board/dist/index.js')) require('child_process').execSync('npm --prefix packages/notes-board run build', {stdio:'inherit'})\"",
    "build:notes:force": "npm --prefix packages/notes-board run build",
    "build:interaction": "node -e \"if (!require('fs').existsSync('packages/interaction-builder/dist/index.js')) require('child_process').execSync('npm --prefix packages/interaction-builder run build', {stdio:'inherit'})\"",
    "build:interaction:force": "npm --prefix packages/interaction-builder run build",
    "prebuild": "npm run build:notes && npm run build:interaction",
    "build": "prisma generate && node --max-old-space-size=4096 --import ./scripts/register-root-environment.mjs ./node_modules/next/dist/bin/next build",
    "verify:vercel": "node scripts/verify-vercel.mjs",
    "update:structure": "node scripts/update-directory-structure.mjs",
    "build:worker": "tsc --project tsconfig.worker.json",
    "worker": "dist-worker/server/worker.js",
    "start:worker": "dist-worker/server/worker.js",
    "creation:worker": "node --conditions=react-server --import tsx --import ./scripts/register-root-environment.mjs src/server/creation-worker.ts",
    "creation:worker:check": "node --conditions=react-server --import tsx --import ./scripts/register-root-environment.mjs src/server/creation-worker.ts --check",
    "creation:sql:smoke": "node --conditions=react-server --import tsx --import ./scripts/register-root-environment.mjs scripts/creation-durability-smoke.ts",
    "creation:storage:smoke": "node --conditions=react-server --import tsx --import ./scripts/register-root-environment.mjs scripts/creation-storage-smoke.ts",
    "creation:readiness": "node --import tsx --import ./scripts/register-root-environment.mjs scripts/creation-readiness.ts",
    "interaction:worker": "node --conditions=react-server --import tsx --import ./scripts/register-root-environment.mjs src/server/interaction-worker.ts",
    "interaction:worker:check": "node --conditions=react-server --import tsx --import ./scripts/register-root-environment.mjs src/server/interaction-worker.ts --check",
    "interaction:readiness": "node --import tsx --import ./scripts/register-root-environment.mjs scripts/interaction-readiness.ts",
    "creation:material:smoke": "node --conditions=react-server --import tsx --import ./scripts/register-root-environment.mjs scripts/creation-material-smoke.ts",
    "postinstall": "prisma generate",
    "start": "node --import ./scripts/register-root-environment.mjs ./node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "mobile:build": "npm --prefix packages/mobile run build",
    "mobile:sync": "npm --prefix packages/mobile run sync",
    "mobile:open": "npm --prefix packages/mobile run open",
    "mobile:run": "npm --prefix packages/mobile run run",
    "mobile:release:aab": "npm --prefix packages/mobile run release:aab",
    "git:sync": "node scripts/sync-planning.mjs",
    "git:push": "node scripts/sync-planning.mjs --push",
    "domshift": "npx @agrimsinghx/domshift 3000"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.92",
    "@auth/prisma-adapter": "^2.11.3",
    "@corsair-dev/github": "^0.1.18",
    "@corsair-dev/notion": "^0.1.5",
    "@google/generative-ai": "^0.24.1",
    "@mozilla/readability": "0.6.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-query": "^5.101.4",
    "@undone/notes-board": "file:./packages/notes-board",
    "interaction-builder": "file:./packages/interaction-builder",
    "ai": "7.0.133",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "corsair": "^0.1.119",
    "framer-motion": "^13.1.0",
    "hls.js": "^1.7.3",
    "jsdom": "26.1.0",
    "lightningcss": "^1.29.1",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^1.27.0",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.3",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "p-limit": "^7.3.1",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-redux": "^9.3.0",
    "server-only": "0.0.1",
    "tsx": "^4.23.12",
    "workflow": "5.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@agrimsinghx/domshift": "file:../domshift/packages/cli",
    "@electric-sql/pglite": "0.4.3",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "30.0.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prettier": "3.9.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "es-toolkit": "1.49.0"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
