{
  "client": {
    "token": {
      "hmac_secret_key": "replace_with_random_32_character_secret_for_jwt",
      "issuer": "undone-messaging",
      "audience": "undone-centrifugo"
    },
    "allowed_origins": [
      "http://localhost:3000",
      "capacitor://localhost",
      "http://localhost"
    ],
    "channel_limit": 32,
    "user_connection_limit": 10,
    "connection_limit": 2000,
    "connection_rate_limit": 100,
    "ping_interval": "25s",
    "pong_timeout": "8s",
    "queue_max_size": 1048576,
    "recovery_max_publication_limit": 300,
    "history_max_publication_limit": 300
  },
  "http_api": {
    "key": "replace_with_random_server_api_key"
  },
  "websocket": {
    "message_size_limit": 65536,
    "compression": false
  },
  "health": {
    "enabled": true
  },
  "prometheus": {
    "enabled": true
  },
  "admin": {
    "enabled": false
  },
  "debug": {
    "enabled": false
  },
  "proxy": {
    "subscribe": {
      "endpoint": "http://host.docker.internal:3000/api/internal/realtime/subscribe",
      "timeout": "2s",
      "http_static_headers": {
        "X-Centrifugo-Proxy-Key": "replace_with_random_proxy_callback_static_key"
      }
    },
    "sub_refresh": {
      "endpoint": "http://host.docker.internal:3000/api/internal/realtime/sub-refresh",
      "timeout": "2s",
      "http_static_headers": {
        "X-Centrifugo-Proxy-Key": "replace_with_random_proxy_callback_static_key"
      }
    }
  },
  "namespaces": [
    {
      "name": "user",
      "subscribe_proxy_enabled": true,
      "sub_refresh_proxy_enabled": true,
      "history_size": 100,
      "history_ttl": "300s",
      "force_recovery": true
    },
    {
      "name": "dm",
      "subscribe_proxy_enabled": true,
      "sub_refresh_proxy_enabled": true,
      "history_size": 100,
      "history_ttl": "300s",
      "force_recovery": true
    },
    {
      "name": "group",
      "subscribe_proxy_enabled": true,
      "sub_refresh_proxy_enabled": true,
      "history_size": 100,
      "history_ttl": "300s",
      "force_recovery": true
    },
    {
      "name": "community",
      "subscribe_proxy_enabled": true,
      "sub_refresh_proxy_enabled": true,
      "history_size": 100,
      "history_ttl": "300s",
      "force_recovery": true
    },
    {
      "name": "room",
      "subscribe_proxy_enabled": true,
      "sub_refresh_proxy_enabled": true,
      "history_size": 100,
      "history_ttl": "300s",
      "force_recovery": true,
      "presence": true,
      "join_leave": true
    },
    {
      "name": "roomchat",
      "subscribe_proxy_enabled": true,
      "sub_refresh_proxy_enabled": true,
      "history_size": 100,
      "history_ttl": "300s",
      "force_recovery": true
    },
    {
      "name": "signal",
      "subscribe_proxy_enabled": true,
      "sub_refresh_proxy_enabled": true
    }
  ]
}
