{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://undone.app/schemas/v1/manifest.json",
  "title": "WorkspaceManifest",
  "type": "object",
  "required": ["manifestVersion", "workspaceId", "notebooks", "notes", "assets"],
  "properties": {
    "manifestVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "workspaceId": {
      "type": "string"
    },
    "notebooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "hash"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "hash", "contentType"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "contentType": { "type": "string", "enum": ["canvas", "kanban", "markdown"] }
        }
      }
    },
    "canvases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["noteId", "path", "hash"],
        "properties": {
          "noteId": { "type": "string" },
          "path": { "type": "string" },
          "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "sha256", "gitSha"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "mimeType": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
