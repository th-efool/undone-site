{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://undone.app/schemas/v1/note.json",
  "title": "ValidationNote",
  "type": "object",
  "required": ["id", "notebookId", "title", "contentType", "order", "createdAt", "updatedAt"],
  "properties": {
    "id": {
      "type": "string"
    },
    "notebookId": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "contentType": {
      "type": "string",
      "enum": ["canvas", "kanban", "markdown"]
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "canvasData": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "items": { "type": "object" }
        },
        "appState": {
          "type": "object"
        },
        "assetFileIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["elements", "appState"]
    },
    "kanbanData": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "order"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "order": { "type": "integer" }
            }
          }
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "columnId", "title", "order"],
            "properties": {
              "id": { "type": "string" },
              "columnId": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "order": { "type": "integer" }
            }
          }
        }
      },
      "required": ["columns", "cards"]
    }
  },
  "additionalProperties": false
}
