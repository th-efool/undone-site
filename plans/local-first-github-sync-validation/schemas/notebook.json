{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://undone.app/schemas/v1/notebook.json",
  "title": "ValidationNotebook",
  "type": "object",
  "required": ["id", "title", "color", "icon", "favorite", "archived", "order"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^nb-[a-zA-Z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "icon": {
      "type": "string"
    },
    "favorite": {
      "type": "boolean"
    },
    "shared": {
      "type": "boolean"
    },
    "archived": {
      "type": "boolean"
    },
    "collapsed": {
      "type": "boolean"
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
