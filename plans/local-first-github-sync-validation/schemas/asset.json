{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://undone.app/schemas/v1/asset.json",
  "title": "ValidationAsset",
  "type": "object",
  "required": ["id", "hash", "mimeType", "byteLength", "base64Data"],
  "properties": {
    "id": {
      "type": "string"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Cryptographic SHA-256 hash of the decoded raw binary payload"
    },
    "mimeType": {
      "type": "string",
      "enum": [
        "image/png",
        "image/jpeg",
        "image/svg+xml",
        "image/webp",
        "image/gif",
        "application/octet-stream"
      ]
    },
    "byteLength": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5242880,
      "description": "Raw unencoded binary size in bytes (max 5 MiB ceiling; direct transport max 3.0 MiB)"
    },
    "base64Data": {
      "type": "string",
      "description": "Base64 encoded representation of binary bytes"
    }
  },
  "additionalProperties": false
}
