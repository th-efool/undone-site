{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@undone/notes-board": ["./packages/notes-board/dist/index.js"],
      "@undone/notes-board/canvas": ["./packages/notes-board/dist/canvas.js"],
      "@undone/notes-board/kanban": ["./packages/notes-board/dist/kanban.js"],
      "@undone/notes-board/*": ["./packages/notes-board/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "public",
    ".tmp",
    "out",
    ".vercel",
    "dist-worker",
    "android",
    "packages"
  ]
}
