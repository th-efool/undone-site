# render.yaml
# Place this at the root of your repo. Render reads it on deploy.

databases:
  - name: sidequesthq-postgres
    plan: starter # $7/mo

services:
  - name: sidequesthq-web
    type: web
    env: node
    plan: starter # Upgrade to starter ($7/mo) to avoid sleep/cold-starts for chat
    buildCommand: npm run build
    startCommand: npm start
    envVars:
      - key: NODE_ENV
        value: production
      - key: GEMINI_API_KEY
        sync: false
      - key: DATABASE_URL
        fromDatabase:
          name: sidequesthq-postgres
          property: connectionString
      - key: NEXTAUTH_SECRET
        sync: false
      - key: NEXTAUTH_URL
        sync: false
      - key: CENTRIFUGO_API_KEY
        sync: false

  - name: sidequesthq-worker
    type: worker
    env: node
    plan: starter
    buildCommand: npm install && npm run build:worker
    startCommand: npm run start:worker
    envVars:
      - key: NODE_ENV
        value: production
      - key: GEMINI_API_KEY
        sync: false
      - key: DATABASE_URL
        fromDatabase:
          name: sidequesthq-postgres
          property: connectionString
      - key: WORKER_SECRET
        sync: false

  - name: sidequesthq-centrifugo
    type: web
    env: docker
    plan: starter # $7/mo
    # We use the official Docker image for Centrifugo
    image: centrifugal/centrifugo:v5
    envVars:
      - key: CENTRIFUGO_TOKEN_HMAC_SECRET_KEY
        sync: false # Set this in Render dashboard (should match what the Next.js app uses to mint JWTs)
      - key: CENTRIFUGO_API_KEY
        sync: false # Set this in Render dashboard (Next.js app needs this to publish messages via API)
      - key: CENTRIFUGO_ALLOWED_ORIGINS
        value: "*" # Or your production domains for CORS
