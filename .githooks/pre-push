#!/usr/bin/env sh
if [ "$SYNC_PUSHING" = "1" ]; then
  exit 0
fi

if [ "$(git branch --show-current)" = "planning" ]; then
  exit 0
fi

if [ "$SKIP_VERIFY" != "1" ]; then
  npm run verify:vercel || exit 1
fi

# Sync planning worktree locally
node scripts/sync-planning.mjs

# Push planning to origin; outer git push command will push master cleanly
SYNC_PUSHING=1 git push origin planning || true
exit 0
